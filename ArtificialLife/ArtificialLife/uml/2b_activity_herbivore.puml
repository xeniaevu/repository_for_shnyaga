@startuml activity_herbivore
title Диаграмма деятельности — ход травоядного
start
:Зрение: просмотреть квадрат 5×5;
if (Видит хищника?) then (да)
  :Оценить свободные соседние клетки\n(вверх/вниз/влево/вправо) и «остаться»;
  :Критерий 1: max расстояние до ближайшего хищника\nКритерий 2: max сумма расстояний;
  if (Есть ход не хуже, чем остаться?) then (да)
    :Сделать ход (при равенстве — случайный);
  else (нет)
    :Остаться на месте;
  endif
  note right: Во время бегства\nне ест — ходит только\nпо свободным клеткам
elseif (Растение в соседней клетке\n(не по диагонали)?) then (да)
  :Съесть растение: E += E1;
  :Встать на клетку растения;
elseif (Видит растение?) then (да)
  :Выбрать ближайшее растение;
  if (Можно приблизиться\nпо свободной клетке?) then (да)
    :Шаг к растению;
  else (нет)
    :Случайный шаг;
  endif
else (нет)
  :Случайный шаг в свободную клетку;
endif
:Трата энергии: E -= F;
if (E <= 0?) then (да)
  :Погибнуть (удалиться из среды);
  stop
else (нет)
endif
if (E > H_threshold и есть\nсвободная соседняя клетка?) then (да)
  :Родить потомка с E_child;\nE -= E_child;
else (нет)
endif
stop
@enduml
