@startuml usecase
title Диаграмма прецедентов — «Искусственная жизнь»
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Пользователь" as User
actor "Таймер\n(игровой цикл)" as Timer

rectangle "Оконное приложение «Искусственная жизнь»" {
  usecase "Запустить симуляцию\n(Старт)" as UC_Start
  usecase "Приостановить\n(Пауза)" as UC_Pause
  usecase "Выполнить один шаг\n(Шаг)" as UC_Step
  usecase "Сбросить модель\n(Сброс)" as UC_Reset
  usecase "Настроить параметры" as UC_Settings
  usecase "Изменить скорость" as UC_Speed
  usecase "Наблюдать поле\nи численность видов" as UC_Watch
  usecase "Посмотреть энергию агента\nи его область видимости" as UC_Info
  usecase "Выполнить виток\nмоделирования" as UC_Tick
  usecase "Пересоздать популяции\nс новыми параметрами" as UC_Recreate
}

User --> UC_Start
User --> UC_Pause
User --> UC_Step
User --> UC_Reset
User --> UC_Settings
User --> UC_Speed
User --> UC_Watch
Timer --> UC_Tick

UC_Start ..> UC_Tick : <<include>>
UC_Step ..> UC_Tick : <<include>>
UC_Settings ..> UC_Recreate : <<include>>
UC_Reset ..> UC_Recreate : <<include>>
UC_Info .> UC_Watch : <<extend>>

note right of UC_Tick
  Каждый агент: зрение 5×5 →
  выбор цели → действие →
  трата энергии → смерть / деление
end note
@enduml
