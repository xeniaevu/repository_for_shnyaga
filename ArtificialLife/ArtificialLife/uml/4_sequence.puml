@startuml sequence
title Диаграмма последовательности — один виток времени (оконная версия)
autonumber
actor "Пользователь" as U
participant ":MainPanel" as F
participant ":SimulationController" as C
participant "timer:Timer" as T
participant ":Simulation" as S
participant "h:Herbivore" as H
participant "p:Predator" as P
participant ":Environment" as E
participant ":GridPanel" as G

U -> F : нажать «Старт»
F -> C : start()
C -> T : start()
...каждые 1000/скорость мс...
T -> C : tick()
activate C
C -> S : step()
activate S
S -> S : shuffle(agents)

group для каждого живого агента (пример: травоядное, затем хищник)
  S -> H : live(sim)
  activate H
  H -> E : getNeighbors(x, y, 2)
  E --> H : клетки 5×5
  H -> E : getAgent(x', y')
  E --> H : агенты в зоне видимости
  alt видит хищника
    H -> E : getEmptyOrthogonalNeighbors(x, y)
    E --> H : свободные клетки
    H -> E : moveAgent(h, fx, fy)
  else растение рядом
    H -> H : eat(plant, E1)
    H -> E : moveAgent(h, plantX, plantY)
  end
  H -> H : metabolize() : E -= F
  opt E > H_threshold
    H -> S : spawn(new Herbivore(E_child), x, y)
    S -> E : setAgent(x, y, child)
  end
  deactivate H

  S -> P : live(sim)
  activate P
  P -> E : getOrthogonalNeighbors(x, y)
  E --> P : соседние клетки
  alt травоядное рядом
    P -> H : die(sim)
    H -> E : setAgent(hx, hy, null)
    P -> E : moveAgent(p, hx, hy)
  else видит травоядное
    P -> E : moveAgent(p, nx, ny)
  end
  P -> P : metabolize() : E -= F2
  opt E <= 0
    P -> E : setAgent(x, y, null)
  end
  deactivate P
end

S -> S : удалить погибших, добавить новорождённых
S -> S : updateStats()
S --> C
deactivate S
C -> S : isAnySpeciesExtinct()
S --> C : false
C -> F : refresh() (слушатель)
deactivate C
F -> G : setSimulation(sim) → repaint()
G -> E : getAgent(x, y) для всех клеток
@enduml
