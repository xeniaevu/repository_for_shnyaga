@startuml activity_predator
title Диаграмма деятельности — ход хищника
start
if (Голоден?\n(E < порога сытости)) then (да)
  :Зрение: просмотреть квадрат 5×5;
  if (Травоядное в соседней клетке\n(не по диагонали)?) then (да)
    :Атаковать: травоядное погибает;
    :E += E2;
    :Встать на клетку жертвы;
  elseif (Видит травоядное?) then (да)
    :Выбрать ближайшее (манхэттенское расстояние);
    if (Можно приблизиться\nпо свободной клетке?) then (да)
      :Шаг к травоядному;
    else (нет)
      :Случайный шаг;
    endif
  else (нет)
    :Случайный шаг;
  endif
else (нет — сыт)
  :Случайный шаг;
endif
:Трата энергии: E -= F2;
if (E <= 0?) then (да)
  :Погибнуть;
  stop
else (нет)
endif
if (E > X_threshold и есть\nсвободная соседняя клетка?) then (да)
  :Родить потомка с E_child;\nE -= E_child;
else (нет)
endif
stop
@enduml
